# Copie ce fichier vers .env et renseigne les valeurs.
# .env est ignoré par git : les secrets n'y seront jamais versionnés.

# ---------------------------------------------------------------- BASE ---
# URL Postgres. Sur Neon (neon.com), c'est la « Connection string » du
# tableau de bord. Garde bien ?sslmode=require à la fin.
DATABASE_URL="postgresql://utilisateur:motdepasse@hote.neon.tech/nwc?sslmode=require"

# ------------------------------------------------------------- COMPTE ---
# Utilisés une seule fois, par `npm run db:seed`, pour créer le compte admin.
# Le mot de passe doit faire au moins 10 caractères ; il est haché avant
# d'être stocké. Tu peux vider ces deux lignes une fois le compte créé.
ADMIN_EMAIL="contact@newwaveconception.com"
ADMIN_PASSWORD="a-remplacer-par-un-mot-de-passe-long"

# ------------------------------------------------------------- IMAGES ---
# FACULTATIF. Sans ce jeton, l'envoi de fichiers fonctionne quand même : les
# images sont écrites dans public/uploads/ et servies par le serveur.
#
# À définir IMPÉRATIVEMENT pour un déploiement sur Vercel (ou tout hébergement
# sans disque persistant), où l'écriture de fichiers est impossible :
# Vercel → ton projet → Storage → Blob → créer un store, puis copier le jeton.
BLOB_READ_WRITE_TOKEN=""

# --------------------------------------------------------------- RÉSEAU ---
# À ne définir qu'en local, et seulement si les images distantes renvoient
# « "url" parameter is not allowed » : voir la section NAT64 du README.
# Laisser vide en production.
ALLOW_LOCAL_IP_IMAGES=""
