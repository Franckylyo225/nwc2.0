// Schéma de la base — New Wave Conception
//
// Chaque collection administrable a le même trio de champs de service :
//   position  : ordre d'affichage sur le site public (croissant)
//   published : permet de préparer un contenu sans le publier
//   updatedAt : affiché dans l'admin pour repérer les contenus qui dorment
//
// Après toute modification de ce fichier :
//   npx prisma migrate dev --name <description>

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

// L'URL de connexion ne vit plus ici depuis Prisma 7 : elle est déclarée dans
// prisma.config.ts (migrations) et passée à PrismaClient via l'adaptateur
// Postgres (voir lib/db.ts).
datasource db {
  provider = "postgresql"
}

/// Compte d'administration. Un seul suffit, mais le modèle en accepte plusieurs.
model AdminUser {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  /// Hachage scrypt au format "sel:clé" — jamais le mot de passe en clair.
  password  String
  createdAt DateTime  @default(now())
  sessions  Session[]
}

/// Sessions stockées en base : une déconnexion révoque réellement l'accès,
/// ce qu'un simple cookie signé ne permet pas.
model Session {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  bullets     String[]
  position    Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, position])
}

/// Réalisations — les projets menés pour des clients.
model Work {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  year      String
  category  String
  summary   String
  href      String?
  image     String?
  position  Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, position])
}

/// Projets maison — les SaaS et plateformes développés par l'agence.
model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  tagline     String
  description String
  status      ProductStatus @default(ONLINE)
  tags        String[]
  href        String?
  image       String?
  position    Int           @default(0)
  published   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([published, position])
}

enum ProductStatus {
  ONLINE /// « En ligne »
  BETA /// « Bêta »
  SOON /// « Bientôt »
}

/// Actualités et articles de fond partagent le même modèle, séparés par
/// `category` : une seule liste à administrer, deux rubriques à l'affichage.
model Article {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  category    ArticleCategory @default(NEWS)
  excerpt     String
  /// Corps de l'article en Markdown.
  content     String
  cover       String?
  author      String?
  published   Boolean         @default(false)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([published, publishedAt])
  @@index([category])
}

enum ArticleCategory {
  NEWS /// Actualité de l'agence
  POST /// Article de fond
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  author    String
  role      String
  company   String
  avatar    String?
  position  Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, position])
}
