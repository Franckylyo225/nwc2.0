// Schéma de la base — New Wave Conception
//
// Chaque collection administrable a le même trio de champs de service :
//   position  : ordre d'affichage sur le site public (croissant)
//   published : permet de préparer un contenu sans le publier
//   updatedAt : affiché dans l'admin pour repérer les contenus qui dorment
//
// Après toute modification de ce fichier :
//   npx prisma migrate dev --name <description>

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

// L'URL de connexion ne vit plus ici depuis Prisma 7 : elle est déclarée dans
// prisma.config.ts (migrations) et passée à PrismaClient via l'adaptateur
// Postgres (voir lib/db.ts).
datasource db {
  provider = "postgresql"
}

/// Réglages généraux du site. Table à ligne unique : l'identifiant est fixe,
/// ce qui rend l'écriture idempotente (upsert) sans risque de doublon.
model SiteSettings {
  id                 String    @id @default("settings")
  /// Quand il est actif, les visiteurs voient la page de maintenance.
  /// Un administrateur connecté, lui, continue de voir le vrai site.
  ///
  /// Les `@map` conservent les noms de colonnes d'origine : le champ a été
  /// renommé côté code sans migration, donc sans risque pour les données.
  maintenanceMode    Boolean   @default(false) @map("constructionMode")
  maintenanceTitle   String    @default("Le site arrive bientôt") @map("constructionTitle")
  maintenanceMessage String    @default("Nous préparons quelque chose de mieux. Revenez très vite.") @map("constructionMessage")
  /// Date de réouverture annoncée. Vide : aucune date affichée.
  maintenanceEta     DateTime? @map("constructionEta")
  /// Affiche ou non les coordonnées sur la page de maintenance.
  showContact        Boolean   @default(true)

  /// Vignettes insérées entre les mots du titre d'accueil. Les emplacements
  /// sont définis dans content/site.ts (`imageSlot`) ; seules les images se
  /// gèrent ici, depuis l'administration.
  heroImage1         String?
  heroImage2         String?
  heroImage3         String?

  /// Visuels des blocs du site, gérés depuis l'onglet « CMS » des paramètres.
  /// Même principe que les vignettes ci-dessus : la mise en page vit dans le
  /// code, les images en base. Vides, les blocs affichent leur repli dégradé.
  ///
  /// Fond de la grande carte de présentation, avant les services.
  aboutBannerImage   String?
  /// Portrait ou photo d'équipe de la section « Le studio ».
  aboutStudioImage   String?

  /// Sel du hachage des expéditeurs du formulaire de contact (voir Message).
  /// Tiré au sort à la première réception et jamais réaffiché : il vit ici
  /// plutôt que dans une variable d'environnement pour qu'aucune installation
  /// ne se retrouve à hacher sans sel, faute de l'avoir configurée.
  contactSalt        String?

  updatedAt          DateTime  @updatedAt
}

/// Compte d'administration. Un seul suffit, mais le modèle en accepte plusieurs.
model AdminUser {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  /// Hachage scrypt au format "sel:clé" — jamais le mot de passe en clair.
  password  String
  createdAt DateTime  @default(now())
  sessions  Session[]
}

/// Sessions stockées en base : une déconnexion révoque réellement l'accès,
/// ce qu'un simple cookie signé ne permet pas.
model Session {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  bullets     String[]
  position    Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, position])
}

/// Réalisations — les projets menés pour des clients.
model Work {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  year      String
  /// Rôle tenu sur le projet, affiché tel quel dans la fiche du carrousel.
  category  String
  summary   String
  /// Prestations livrées, une par ligne dans l'administration. Vide, la
  /// colonne correspondante disparaît de la fiche.
  services  String[]
  href      String?
  image     String?
  position  Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, position])
}

/// Projets maison — les SaaS et plateformes développés par l'agence.
model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  tagline     String
  description String
  status      ProductStatus @default(ONLINE)
  tags        String[]
  href        String?
  image       String?
  position    Int           @default(0)
  published   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([published, position])
}

enum ProductStatus {
  ONLINE /// « En ligne »
  BETA /// « Bêta »
  SOON /// « Bientôt »
}

/// Actualités et articles de fond partagent le même modèle, séparés par
/// `category` : une seule liste à administrer, deux rubriques à l'affichage.
model Article {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  category    ArticleCategory @default(NEWS)
  excerpt     String
  /// Corps de l'article en Markdown.
  content     String
  cover       String?
  author      String?
  published   Boolean         @default(false)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([published, publishedAt])
  @@index([category])
}

enum ArticleCategory {
  NEWS /// Actualité de l'agence
  POST /// Article de fond
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  author    String
  role      String
  company   String
  avatar    String?
  position  Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, position])
}

/// Messages reçus par le formulaire de contact.
///
/// Seul modèle alimenté depuis l'extérieur : il n'a donc ni `position` ni
/// `published` — rien ici ne s'affiche sur le site — mais un statut de
/// traitement, qui fait de la boîte de réception une vraie liste de tâches.
model Message {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String?
  company     String?
  /// Type de projet et budget : deux chaînes libres, remplies par le visiteur
  /// à partir des choix de content/site.ts. Stockées telles quelles pour que
  /// modifier ces choix plus tard ne réécrive pas l'historique.
  projectType String?
  budget      String?
  body        String
  status      MessageStatus @default(NEW)
  /// Empreinte salée de l'adresse IP — jamais l'adresse elle-même. Elle ne
  /// sert qu'à repérer les envois en rafale ; sans le sel, qui vit en base,
  /// elle ne se remonte pas.
  senderHash  String
  createdAt   DateTime      @default(now())

  @@index([status, createdAt])
  @@index([senderHash, createdAt])
}

enum MessageStatus {
  NEW /// Reçu, pas encore lu
  READ /// Lu, en cours de traitement
  ARCHIVED /// Traité, rangé
}
