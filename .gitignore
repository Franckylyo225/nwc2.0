# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Client Prisma généré (recréé par `npx prisma generate`)
/lib/generated

# Variables d’environnement — tout .env* sauf l'exemple
.env*
!.env.example
# Images envoyées depuis l’administration (stockage local)
/public/uploads/*
!/public/uploads/.gitkeep
